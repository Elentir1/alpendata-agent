FROM docker.io/library/python:3.13-slim-trixie@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_PROJECT_ENVIRONMENT=/opt/venv
RUN python -m pip install --no-cache-dir uv==0.11.6
WORKDIR /opt/hermes
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --no-default-groups --no-install-project
COPY . .
RUN uv pip install --python /opt/venv/bin/python --no-deps -e . \
    && useradd --uid 1000 --no-create-home --home-dir /state alpendata

ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin HOME=/state HERMES_HOME=/state/.hermes
USER 1000:1000
WORKDIR /state
ENTRYPOINT ["/opt/venv/bin/python", "/opt/hermes/alpendata/runtime/worker.py"]
